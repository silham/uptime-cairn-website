# The blog. Both are public: they identify a dataset, not a person, and they
# are compiled into the client bundle by design — the Studio at /studio needs
# them in the browser. There is no read token, because everything this site
# reads is published content.
#
# Copy to .env.local and fill in from https://sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The GROQ/API version the client is pinned to. Change it deliberately, never
# to "latest" — see the note in lib/sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01
